# Copy to .env and adjust values for local development.
# Docker Compose sets these automatically — no .env file needed in Docker.

DEBUG=1
SECRET_KEY=django-insecure-dev-secret-key-for-placex-portal

DB_HOST=localhost
DB_PORT=5432
DB_NAME=place_x
DB_USER=postgres
DB_PASSWORD=postgres

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=place_x_mongo

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
