# Production environment template for PlaceX.
# Copy to `.env` on the EC2 host and edit the values below.
#   cp .env.prod.example .env
#
# Generate a strong SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# --- PostgreSQL (used by Django) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=placex_db
DB_USER=placex_user
DB_PASSWORD=change-me-strong-password

# --- PostgreSQL (used by the database container to initialize) ---
# MUST match DB_NAME / DB_USER / DB_PASSWORD above.
POSTGRES_DB=placex_db
POSTGRES_USER=placex_user
POSTGRES_PASSWORD=change-me-strong-password

# --- MongoDB ---
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=placex_db

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0